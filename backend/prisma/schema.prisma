// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  EMPLOYE
  AGENT
  MANAGER
  ADMIN
}

enum Priorite {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum StatutDemande {
  NOUVEAU
  EN_ATTENTE_APPROBATION
  EN_COURS
  RESOLU
  CLOTURE
  REJETE
  ANNULE
}

enum VisibiliteCommentaire {
  INTERNE
  PUBLIC
}

enum StatutApprobation {
  EN_ATTENTE
  APPROUVE
  REJETE
}

model Utilisateur {
  id            Int      @id @default(autoincrement())
  nom           String
  prenom        String
  email         String   @unique
  motDePasse    String
  role          Role
  departementId Int?     @map("departement_id")
  departement   Departement? @relation(fields: [departementId], references: [id])

  demandesCreees    Demande[] @relation("Demandeur")
  demandesAssignees Demande[] @relation("Agent")
  commentaires      Commentaire[]
  historique        HistoriqueAction[]
  approbations      Approbation[]
  notifications     Notification[]

  @@map("utilisateurs")
}

model Departement {
  id  Int    @id @default(autoincrement())
  nom String @unique

  categories   Categorie[]
  utilisateurs Utilisateur[]
  demandes     Demande[]

  @@map("departements")
}

model Categorie {
  id              Int    @id @default(autoincrement())
  nom             String
  departementId   Int    @map("departement_id")
  departement     Departement @relation(fields: [departementId], references: [id])
  delaiReponse    Int
  delaiResolution Int

  demandes       Demande[]
  workflowEtapes WorkflowEtape[]

  @@map("categories")
}

model Demande {
  id            Int           @id @default(autoincrement())
  titre         String
  description   String
  priorite      Priorite
  statut        StatutDemande @default(NOUVEAU)

  departementId Int         @map("departement_id")
  departement   Departement @relation(fields: [departementId], references: [id])

  categorieId   Int       @map("categorie_id")
  categorie     Categorie @relation(fields: [categorieId], references: [id])

  demandeurId   Int         @map("demandeur_id")
  demandeur     Utilisateur @relation("Demandeur", fields: [demandeurId], references: [id])

  agentId       Int?         @map("agent_id")
  agent         Utilisateur? @relation("Agent", fields: [agentId], references: [id])

  dateCreation  DateTime  @default(now())
  dateCloture   DateTime?
  dateLimiteSLA DateTime?
  metadata      Json?

  commentaires  Commentaire[]
  piecesJointes PieceJointe[]
  historique    HistoriqueAction[]
  approbations  Approbation[]

  @@index([departementId])
  @@index([categorieId])
  @@index([demandeurId])
  @@index([statut])
  @@index([priorite])
  @@map("demandes")
}

model Commentaire {
  id         Int      @id @default(autoincrement())
  demandeId  Int      @map("demande_id")
  demande    Demande  @relation(fields: [demandeId], references: [id])
  auteurId   Int      @map("auteur_id")
  auteur     Utilisateur @relation(fields: [auteurId], references: [id])
  contenu    String
  visibilite VisibiliteCommentaire
  date       DateTime @default(now())

  @@map("commentaires")
}

model PieceJointe {
  id            Int      @id @default(autoincrement())
  demandeId     Int      @map("demande_id")
  demande       Demande  @relation(fields: [demandeId], references: [id])
  nomFichier    String
  cheminFichier String
  dateUpload    DateTime @default(now())

  @@map("pieces_jointes")
}

model HistoriqueAction {
  id        Int      @id @default(autoincrement())
  demandeId Int      @map("demande_id")
  demande   Demande  @relation(fields: [demandeId], references: [id])
  auteurId  Int      @map("auteur_id")
  auteur    Utilisateur @relation(fields: [auteurId], references: [id])
  action    String
  date      DateTime @default(now())

  @@map("historique_actions")
}

model WorkflowEtape {
  id              Int    @id @default(autoincrement())
  categorieId     Int    @map("categorie_id")
  categorie       Categorie @relation(fields: [categorieId], references: [id])
  ordre           Int
  roleApprobateur Role

  approbations Approbation[]

  @@unique([categorieId, ordre])
  @@map("workflow_etapes")
}

model Approbation {
  id            Int      @id @default(autoincrement())
  demandeId     Int      @map("demande_id")
  demande       Demande  @relation(fields: [demandeId], references: [id])
  etapeId       Int      @map("etape_id")
  etape         WorkflowEtape @relation(fields: [etapeId], references: [id])
  approbateurId Int?     @map("approbateur_id")
  approbateur   Utilisateur? @relation(fields: [approbateurId], references: [id])
  statut        StatutApprobation @default(EN_ATTENTE)
  date          DateTime?
  commentaire   String?

  @@map("approbations")
}

model Notification {
  id            Int      @id @default(autoincrement())
  utilisateurId Int      @map("utilisateur_id")
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  message       String
  lien          String?
  lu            Boolean  @default(false)
  date          DateTime @default(now())

  @@map("notifications")
}
