# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/cires_demandes?schema=public"

# Secret used to sign/verify JWT access tokens — use a long random string
JWT_ACCESS_SECRET=

# JWT access token lifetime (e.g. 8h, 15m, 7d)
JWT_ACCESS_EXPIRES_IN=8h

# Allowed origin for CORS (HTTP + WebSocket) — the frontend's URL
CORS_ORIGIN=http://localhost:4200

# Port the API listens on (optional, defaults to 3000)
PORT=3000

# SMTP server used to send email notifications.
# Leave all SMTP_* vars empty in development to fall back to a throwaway
# Ethereal test inbox (preview links are logged to the console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM must be a sender verified in your SMTP provider's dashboard
# (e.g. Brevo > Senders, Domains & Dedicated IPs), otherwise the provider
# may silently accept the message but never actually deliver it.
SMTP_FROM="Cires Flow <no-reply@cires-flow.local>"
